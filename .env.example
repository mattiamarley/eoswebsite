NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Configure in hosting secrets; never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
# Enable after applying the intake migration and publishing the final privacy notice.
APPLICATIONS_ENABLED=false

# Optional canonical domain for sitemap and social links. Uses this Vercel URL by default.
# Set to the final HTTPS domain (without a path) when it is connected.
SITE_URL=https://eoswebsite.vercel.app
