@import "tailwindcss";

@theme {
  /* ── Sito pubblico (CLAUDE.md §7) ── */
  --color-brand-dark:         #0D1B40;
  --color-brand-accent:       #9186D9;
  --color-brand-accent-light: #EAE8F8;

  /* ── Admin dashboard ── */
  --color-ink:            #1a2b5e;
  --color-ink-deep:       #142348;
  --color-ink-soft:       #3a4a7a;
  --color-lavender:       #b5afe2;
  --color-lavender-light: #d8d5f1;
  --color-lavender-dark:  #9a90d4;
  --color-mist:           #f4f5fa;
  --color-haze:           #e9eaf2;
  --color-muted:          #6b7490;

  --font-sans: var(--font-inter, "Inter"), ui-sans-serif, system-ui, sans-serif;

  --radius-card:  1.5rem;
  --radius-panel: 1.25rem;

  --shadow-soft: 0 10px 40px -12px rgb(26 43 94 / 0.18);
  --shadow-lift: 0 20px 60px -20px rgb(26 43 94 / 0.28);
}

@layer components {
  .glass {
    background: linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.25));
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgb(255 255 255 / 0.5);
    box-shadow: 0 10px 40px -12px rgb(26 43 94 / 0.18), inset 0 1px 0 0 rgb(255 255 255 / 0.6);
  }

  .glass-accent {
    background:
      radial-gradient(120% 140% at 18% 0%, rgb(181 175 226 / 0.45), transparent 55%),
      linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.30));
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid rgb(255 255 255 / 0.5);
    box-shadow: 0 12px 48px -14px rgb(26 43 94 / 0.22), inset 0 1px 0 0 rgb(255 255 255 / 0.6);
  }

  .scroll-soft {
    scrollbar-width: thin;
    scrollbar-color: rgb(26 43 94 / 0.25) transparent;
  }
  .scroll-soft::-webkit-scrollbar { width: 6px; }
  .scroll-soft::-webkit-scrollbar-thumb { background: rgb(26 43 94 / 0.25); border-radius: 9999px; }
  .scroll-soft::-webkit-scrollbar-track { background: transparent; }
}

body {
  background: #f4f5fa;
  color: #1a2b5e;
}

/* Public website: original navy/lavender palette, technical drawing and floating glass. */
html { scroll-behavior: smooth; scroll-padding-top: 110px; }
:focus-visible { outline: 3px solid var(--color-lavender-dark); outline-offset: 5px; }
button, a { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
.site-header { position: fixed; top: 22px; inset-inline: 24px; z-index: 40; display: flex; justify-content: center; pointer-events: none; }
.skip-link { position: fixed; top: -100px; left: 12px; z-index: 100; padding: 12px; background: white; }
.skip-link:focus { top: 12px; }
.section-wrap { width: min(1180px, calc(100% - 96px)); margin-inline: auto; }
.eyebrow { font-size: 10px; font-weight: 600; line-height: 1.6; letter-spacing: 2px; text-transform: uppercase; }
.hero-scroll { height: 215svh; background: var(--color-mist); }
.hero-sticky { height: 100svh; min-height: 700px; position: sticky; top: 0; overflow: hidden; background: radial-gradient(ellipse at 50% 70%, rgb(216 213 241 / .4), transparent 58%), var(--color-mist); }
.hero-heading { text-align: center; padding: 145px 24px 0; position: relative; z-index: 1; }
.hero-heading .eyebrow { color: var(--color-ink-soft); margin-bottom: 18px; }
h1, h2, h3 { letter-spacing: -.045em; }
.hero-heading h1 { font-size: clamp(42px, 5.2vw, 76px); line-height: 1.04; font-weight: 700; }
h1 span, h2 span { font-weight: 300; }
.hero-subtitle { margin-top: 20px; font-size: 14px; color: var(--color-ink-soft); }
.hero-drawing { position: absolute; inset: 36% 15% 9%; display: flex; justify-content: center; }
.blueprint { width: 100%; height: 100%; }
.hero-foot { position: absolute; bottom: 47px; left: 48px; right: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.scroll-invitation { display: flex; align-items: center; gap: 14px; font-size: 11px; }
.scroll-invitation > span { font-size: 23px; }
.build-legend { border-radius: 16px; padding: 17px 24px; display: flex; gap: 24px; font-size: 11px; }
.build-legend > div { min-width: 90px; }
.build-legend span { font-size: 9px; opacity: .55; padding-right: 8px; }
.phase-track { height: 2px; margin-top: 10px; background: var(--color-haze); overflow: hidden; }
.phase-track > div { height: 100%; background: var(--color-ink); transform-origin: left; }
.drawing-caption { position: absolute; bottom: 15px; left: 0; right: 0; text-align: center; font-family: monospace; font-size: 8px; letter-spacing: 2px; color: var(--color-muted); }
.text-link { display: inline-flex; align-items: center; gap: 24px; font-size: 13px; min-height: 44px; }
.text-link:hover { text-decoration: underline; text-underline-offset: 6px; }
.intro-section { padding-block: 110px; }
.intro-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; margin-top: 28px; }
h2 { font-size: clamp(34px, 4vw, 55px); line-height: 1.12; font-weight: 700; }
.body-copy { font-size: 15px; line-height: 1.85; color: var(--color-ink-soft); max-width: 640px; margin-block: 20px; }
.disciplines { display: grid; grid-template-columns: repeat(3,1fr); gap: 30px; margin-top: 65px; }
.disciplines > div { display: flex; align-items: center; gap: 18px; border-top: 1px solid var(--color-haze); padding-top: 24px; }
.disciplines h3 { font-size: 17px; font-weight: 400; letter-spacing: -.02em; }
.disciplines > div > span:last-child { margin-left: auto; }
.expertise-band { margin: 0 24px; background: var(--color-ink-deep); color: white; border-radius: 24px; padding: 72px 0; }
.expertise-band .body-copy { color: rgb(255 255 255 / .65); }
.expertise-band .cards-grid { margin-top: 45px; }
.expertise-band .text-link { margin-top: 24px; }
.cards-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
.content-card { background: white; border: 1px solid var(--color-haze); border-radius: 24px; overflow: hidden; text-align: left; transition: transform .3s, box-shadow .3s; color: var(--color-ink); min-width: 0; }
.content-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); }
.card-art { position: relative; height: 255px; background: var(--color-lavender-light); padding: 8px; }
.variant-1 .card-art, .dialog-art.variant-1 { background: var(--color-ink-deep); color: white; }
.variant-2 .card-art, .dialog-art.variant-2 { background: var(--color-haze); }
.art-index { position: absolute; left: 23px; top: 23px; font: 9px monospace; letter-spacing: 2px; }
.card-body { position: relative; padding: 24px 60px 28px 24px; }
.card-body .eyebrow { font-size: 8px; letter-spacing: 1.6px; color: var(--color-muted); }
.card-body h3 { font-size: 21px; font-weight: 600; line-height: 1.2; margin-top: 10px; }
.card-body p { color: var(--color-muted); font-size: 12px; margin-top: 10px; }
.card-arrow { position: absolute; right: 20px; bottom: 24px; border-radius: 50%; width: 35px; height: 35px; display: grid; place-items: center; background: var(--color-lavender); font-size: 24px; }
.services { grid-template-columns: repeat(2,minmax(0,1fr)); }
.services .content-card { border-radius: 100px; }
.services .card-body { padding: 24px 68px 24px 28px; }
.services .eyebrow { display: none; }
.services h3 { margin: 0; font-size: 17px; letter-spacing: -.025em; }
.services .card-arrow { bottom: 17px; }
.projects-section { padding-block: 110px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 45px; }
.section-heading .eyebrow { margin-bottom: 20px; }
.sample-note { font-size: 11px; color: var(--color-muted); margin-top: 20px; }
.contact-banner { padding: 60px; background: var(--color-lavender-light); border-radius: 24px; margin-bottom: 100px; display: flex; justify-content: space-between; gap: 30px; align-items: center; }
.contact-banner h2 { margin-top: 20px; font-size: clamp(32px,3.3vw,46px); }
.pill-button { border-radius: 100px; background: var(--color-lavender); color: var(--color-ink); display: inline-flex; align-items: center; justify-content: center; gap: 22px; padding: 17px 27px; font-size: 13px; font-weight: 600; min-height: 48px; transition: background .2s; }
.pill-button:hover { background: var(--color-lavender-dark); }
.pill-button.secondary { background: rgb(255 255 255 / .65); border: 1px solid var(--color-haze); margin-top: 28px; }
.page-heading { padding-top: 170px; padding-bottom: 70px; }
.page-heading h1 { font-size: clamp(44px,6vw,78px); font-weight: 700; line-height: 1.1; margin-top: 24px; }
.page-heading > p:last-child { font-size: clamp(20px,2.5vw,32px); font-weight: 300; margin-top: 14px; }
.page-content { padding-bottom: 100px; }
.page-intro { margin: 0 auto 70px; }
.filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 35px; }
.filters button { font-size: 12px; padding: 12px 20px; border-radius: 100px; border: 1px solid var(--color-haze); }
.filters button[aria-pressed=true] { background: var(--color-ink); color: white; }
/* Liquid glass: translucent body, blurred background and a rounded optical rim. */
.detail-dialog {
  --glass-light-x: 25%;
  --glass-light-y: 12%;
  border: 1px solid rgb(255 255 255 / .72);
  border-radius: 38px;
  width: min(760px, calc(100% - 32px));
  max-height: 88dvh;
  margin: auto;
  padding: 0;
  overflow: hidden;
  color: var(--color-ink);
  background: linear-gradient(140deg, rgb(255 255 255 / .38), rgb(244 245 250 / .22) 48%, rgb(255 255 255 / .32));
  backdrop-filter: blur(20px) saturate(135%) brightness(1.08);
  -webkit-backdrop-filter: blur(20px) saturate(135%) brightness(1.08);
  box-shadow: 0 24px 65px -25px rgb(20 35 72 / .25),
    inset 0 2px 2px rgb(255 255 255 / .95),
    inset 2px 0 3px rgb(255 255 255 / .64),
    inset -1px -3px 4px rgb(255 255 255 / .86),
    inset 0 -12px 20px -18px rgb(26 43 94 / .45);
  animation: dialog-in .3s ease both;
}
.detail-dialog::before, .detail-dialog::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
}
.detail-dialog::before {
  background: radial-gradient(ellipse at var(--glass-light-x) var(--glass-light-y), rgb(255 255 255 / .48), transparent 52%),
    linear-gradient(118deg, rgb(255 255 255 / .18), transparent 34%, transparent 75%, rgb(255 255 255 / .16));
}
.detail-dialog::after {
  padding: 2px;
  background: linear-gradient(135deg, white, rgb(255 255 255 / .12) 28%, rgb(255 255 255 / .18) 55%, white 83%, rgb(255 255 255 / .4));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
}
.detail-dialog::backdrop {
  background: rgb(20 35 72 / .08);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
}
.dialog-interior { position: relative; z-index: 1; padding: 40px; max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: rgb(26 43 94 / .25) transparent; }
.dialog-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
.round-button { width: 44px; height: 44px; border-radius: 50%; font-size: 28px; display: grid; place-items: center; }
.detail-dialog h2 { font-size: clamp(28px,5vw,44px); }
.category-chip { display: inline-block; border-radius: 100px; background: var(--color-ink); color: white; padding: 7px 14px; font-size: 11px; margin-top: 18px; }
.dialog-art { background: var(--color-lavender-light); height: 280px; border-radius: 20px; margin-top: 28px; }
.detail-dialog .pill-button { margin-right: 12px; }
.mobile-links { display: flex; flex-direction: column; margin: 24px 0; }
.mobile-links a { padding: 17px 0; font-size: 24px; border-bottom: 1px solid var(--color-haze); display: flex; justify-content: space-between; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 45px; }
.address-card { background: white; border-radius: 24px; padding: 36px; border: 1px solid var(--color-haze); }
.address-card h2 { font-size: 34px; margin: 20px 0; }
.contact-methods { display: flex; flex-wrap: wrap; gap: 18px 45px; margin-bottom: 50px; font-size: 20px; }
.empty-state { padding: 45px; border-radius: 24px; background: white; border: 1px solid var(--color-haze); }
.card-photo { width: 100%; height: 100%; object-fit: cover; }
@keyframes dialog-in { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }
@media(min-height:900px) { .hero-drawing { top: 33%; } }
@media(max-width:1023px) {
  .section-wrap { width: calc(100% - 48px); }
  .hero-heading { padding-top: 135px; }
  .hero-foot { left: 24px; right: 24px; }
  .hero-foot > .text-link { display: none; }
  .hero-drawing { inset: 38% 3% 12%; }
  .intro-grid { gap: 35px; }
  .cards-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .projects-section .cards-grid > :last-child:nth-child(3) { grid-column: 1 / -1; }
  .contact-banner { padding: 40px; flex-direction: column; align-items: start; }
  .disciplines { gap: 16px; }
}
@media(max-width:640px) {
  .site-header { top: 14px; inset-inline: 18px; }
  .hero-scroll { height: 185svh; }
  .hero-sticky { min-height: 650px; }
  .hero-heading { padding-top: 126px; }
  .hero-heading .eyebrow { font-size: 8px; letter-spacing: 1.7px; }
  .hero-heading h1 { font-size: clamp(35px,9vw,54px); }
  .hero-subtitle { font-size: 11px; margin-top: 18px; }
  .hero-drawing { inset: 31% -3% 17%; }
  .hero-foot { bottom: 38px; flex-direction: column-reverse; gap: 18px; }
  .build-legend { width: 100%; justify-content: space-between; gap: 12px; padding: 14px 18px; }
  .build-legend > div { min-width: 0; flex: 1; font-size: 10px; }
  .scroll-invitation { font-size: 10px; }
  .scroll-invitation > span { font-size: 17px; }
  .drawing-caption { font-size: 6px; letter-spacing: 1.2px; bottom: 14px; }
  .section-wrap { width: calc(100% - 40px); }
  .intro-section,.projects-section { padding-block: 70px; }
  .intro-grid { grid-template-columns: 1fr; gap: 12px; }
  .body-copy { font-size: 14px; }
  .disciplines { grid-template-columns: 1fr; margin-top: 35px; }
  .disciplines > div { padding-block: 16px; }
  .expertise-band { margin: 0 10px; padding-block: 45px; }
  .expertise-band .section-wrap { width: calc(100% - 36px); }
  .cards-grid { grid-template-columns: 1fr; gap: 18px; }
  .card-art { height: 240px; }
  .section-heading { align-items: start; flex-direction: column; gap: 15px; margin-bottom: 25px; }
  .contact-banner { padding: 30px 24px; margin-bottom: 55px; }
  .page-heading { padding-top: 133px; padding-bottom: 48px; }
  .page-content { padding-bottom: 65px; }
  .page-intro { margin-bottom: 40px; }
  .contact-grid { grid-template-columns: 1fr; }
  .address-card { padding: 28px; }
  .contact-methods { flex-direction: column; font-size: 18px; gap: 20px; }
  .dialog-interior { padding: 24px; }
  .dialog-toolbar .eyebrow { font-size: 8px; }
  .dialog-art { height: 220px; }
}
@media(prefers-reduced-motion:reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  .hero-scroll { height: auto; }
  .hero-sticky { position: relative; }
}
.detail-gallery { display: grid; gap: 16px; margin-block: 24px; }
.detail-photo { border-radius: 16px; width: 100%; height: auto; }
.application-form { margin-top: 30px; display: grid; gap: 18px; }
.application-form h3 { font-size: 24px; font-weight: 600; }
.application-form label { display: grid; gap: 8px; font-size: 13px; }
.application-form input:not([type=checkbox]) { background: rgb(255 255 255 / .8); border: 1px solid var(--color-haze); border-radius: 10px; padding: 12px; width: 100%; }
.application-form p { font-size: 12px; line-height: 1.6; }
.application-form .consent { display: flex; align-items: start; gap: 10px; line-height: 1.7; }
.consent input { margin-top: 5px; }
.consent a { text-decoration: underline; }
.application-form .form-trap { position: absolute; left: -10000px; }
.application-form button:disabled { opacity: .6; cursor: wait; }
@media(max-height:650px) and (min-width:641px) {
  .hero-sticky { min-height: 0; }
  .hero-heading { width: 48%; text-align: left; padding: 120px 0 0 32px; }
  .hero-heading h1 { font-size: clamp(28px,3.6vw,44px); }
  .hero-heading .eyebrow { font-size: 8px; margin-bottom: 12px; }
  .hero-subtitle { font-size: 11px; margin-top: 12px; }
  .hero-drawing { inset: 18% 1% 19% 43%; }
  .hero-foot { bottom: 30px; }
  .build-legend { padding: 10px 18px; }
  .drawing-caption { bottom: 8px; }
}

/* Figma navbar: a small central logo unfolds equally to either side. */
.logo-navigation { position: relative; width: 44px; height: 44px; border-radius: 5px; background: #091a45; color: white; pointer-events: auto; transition: width .45s cubic-bezier(.22,1,.36,1), border-radius .45s; }
.center-wordmark { position: absolute; inset: 0; width: 44px; height: 44px; margin: auto; display: grid; place-items: center; color: white; font-family: Arial,sans-serif; font-size: 23px; letter-spacing: -.8px; font-weight: 400; }
.logo-navigation:focus-within { width: min(734px, calc(100vw - 48px)); border-radius: 12px; }
.nav-wing { position: absolute; top: 0; height: 44px; display: flex; align-items: center; gap: 28px; white-space: nowrap; opacity: 0; visibility: hidden; transition: opacity .18s, visibility .18s; font-size: 13px; }
.nav-wing-left { left: 23px; }
.nav-wing-right { right: 23px; }
.nav-wing a { display: flex; align-items: center; min-height: 44px; color: rgb(255 255 255 / .85); }
.nav-wing a:hover,.nav-wing a[aria-current] { color: white; text-decoration: underline; text-underline-offset: 5px; }
.logo-navigation:focus-within .nav-wing { opacity: 1; visibility: visible; transition-delay: .15s; }
.touch-navigation { display: none; position: relative; width: 88px; height: 44px; background: #091a45; color: white; border-radius: 10px; pointer-events: auto; }
.touch-navigation .center-wordmark { right: auto; }
.touch-menu-button { position: absolute; right: 0; top: 0; width: 44px; height: 44px; display: grid; place-items: center; }
@media(hover:hover) and (pointer:fine) {
  .logo-navigation:hover { width: min(734px, calc(100vw - 48px)); border-radius: 12px; }
  .logo-navigation:hover .nav-wing { opacity: 1; visibility: visible; transition-delay: .15s; }
}
@media(max-width:767px),(hover:none),(pointer:coarse) {
  .logo-navigation { display: none; }
  .touch-navigation { display: block; }
}
.arrow-icon { display: inline-block; vertical-align: middle; flex-shrink: 0; width: 24px; height: 24px; }
.card-arrow { background: linear-gradient(135deg,#bdb7dd,#a79dcc); color: white; border: 1px solid rgb(255 255 255 / .8); box-shadow: 0 5px 12px rgb(26 43 94 / .18), inset 0 1px 2px rgb(255 255 255 / .35); }
.card-arrow .arrow-icon { width: 24px; height: 24px; }
.text-link .arrow-icon,.pill-button .arrow-icon,.contact-methods .arrow-icon { width: 20px; height: 20px; }

.detail-dialog .dialog-art { background-color: rgb(181 175 226 / .2); border: 1px solid rgb(255 255 255 / .5); }
.detail-dialog .dialog-art.variant-1 { background-color: rgb(20 35 72 / .8); }
.detail-dialog .dialog-art.variant-2 { background-color: rgb(233 234 242 / .3); }
.detail-dialog .pill-button.secondary { background: linear-gradient(135deg,rgb(255 255 255 / .46),rgb(255 255 255 / .16)); border-color: rgb(255 255 255 / .7); box-shadow: inset 0 1px 0 rgb(255 255 255 / .6); }
/* The same polished edge on the floating blueprint controls. */
.build-legend.glass {
  backdrop-filter: blur(18px) saturate(135%);
  -webkit-backdrop-filter: blur(18px) saturate(135%);
  background: linear-gradient(130deg, rgb(255 255 255 / .38), rgb(255 255 255 / .12));
  border-color: rgb(255 255 255 / .72);
  box-shadow: 0 12px 35px -18px rgb(26 43 94 / .25), inset 0 2px 2px rgb(255 255 255 / .95), inset -1px -2px 3px rgb(255 255 255 / .72);
}
.detail-dialog .round-button.glass {
  background: linear-gradient(135deg, rgb(255 255 255 / .48), rgb(255 255 255 / .12));
  box-shadow: inset 0 1px 2px white, inset 0 -1px 2px rgb(255 255 255 / .7), 0 5px 15px -7px rgb(26 43 94 / .3);
}
@media(max-width:640px) { .detail-dialog { border-radius: 28px; } }
@media(prefers-reduced-transparency:reduce) {
  .detail-dialog, .build-legend.glass { --dialog-glass-filter: none; background: var(--color-mist); backdrop-filter: none; -webkit-backdrop-filter: none; }
  .detail-dialog::before { display: none; }
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))) {
  .detail-dialog, .build-legend.glass { background: var(--color-mist); }
}
